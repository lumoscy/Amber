{
  "manifest_version": 3,
  "name": "__MSG_extensionName__",
  "version": "1.1.1",
  "default_locale": "zh_CN",
  "description": "__MSG_extensionDescription__",
  "icons": {
    "16": "assets/icon-16.png",
    "32": "assets/icon-32.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  },
  "action": {
    "default_title": "显示货源增强筛选",
    "default_icon": {
      "16": "assets/icon-16.png",
      "32": "assets/icon-32.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://pay.ldxp.cn/*",
    "https://www.ldxp.cn/*",
    "https://wzyp.cn/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon-48.png"
      ],
      "matches": [
        "https://pay.ldxp.cn/*",
        "https://www.ldxp.cn/*",
        "https://wzyp.cn/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://pay.ldxp.cn/*",
        "https://www.ldxp.cn/*",
        "https://wzyp.cn/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
